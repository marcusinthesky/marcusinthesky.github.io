{
  "name": "@marcusinthesky/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "generate": "bun scripts/generate-public-data.ts && bun scripts/generate-images.ts",
    "build": "bun run generate && next build --webpack && bun scripts/strip-runtime.ts",
    "start": "bun scripts/serve.ts",
    "lint": "oxlint --type-aware src scripts *.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "audit:privacy": "bun scripts/audit-privacy.ts",
    "audit:export": "bun scripts/audit-export.ts && bun scripts/audit-publishing.ts"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@marcusinthesky/content": "workspace:*",
    "@marcusinthesky/ui": "workspace:*",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "16.35.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.88.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
