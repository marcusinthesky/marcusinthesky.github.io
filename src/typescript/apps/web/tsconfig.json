{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "types": ["bun"],
    "paths": { "@/*": ["./src/*"] },
    "jsx": "preserve",
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".source/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "source.config.ts",
    "next.config.ts"
  ],
  "exclude": ["node_modules"]
}
