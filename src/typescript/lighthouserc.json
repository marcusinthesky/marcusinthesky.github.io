{
  "ci": {
    "collect": {
      "startServerCommand": "bun --cwd apps/web start",
      "startServerReadyPattern": "Serving",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/publications/",
        "http://127.0.0.1:4173/projects/pricing-perspective/",
        "http://127.0.0.1:4173/blog/",
        "http://127.0.0.1:4173/cv/"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 1 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01 }],
        "total-blocking-time": ["error", { "maxNumericValue": 50 }],
        "total-byte-weight": ["error", { "maxNumericValue": 524288 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 81920 }]
      }
    }
  }
}
