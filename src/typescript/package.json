{
  "name": "@marcusinthesky/workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "knip": "knip",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run knip && bun run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "knip": "6.43.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.13"
}
